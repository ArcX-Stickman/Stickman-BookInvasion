  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 760218f00b7f66e4bb4eb144a5be015b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  MainIMG: {fileID: 1319227734}
  TipIMG:
  - {fileID: 21300000, guid: b209801097bc1c04b84635ef7bba9b4d, type: 3}
  - {fileID: 21300000, guid: b6dc690f79e30ea4598142b44bcde102, type: 3}
  - {fileID: 21300000, guid: 3a5f35da6c9ba544ea727cfcf466ee58, type: 3}
  - {fileID: 21300000, guid: f14920a785b429c45affee66cc80e97e, type: 3}
  TipText:
  - 'Yo Imma Teach You How To Fight! These Books Are Gonna Try To Kill You If They
    See You. Right Now All You Got Are Your Fists. Holding [RIGHT CLICK] Or Simply
    by punching Homes You Into an Enemy You Are Facing.  '
  - To Avoid Or Dodge Enemy Attack You Got A 2 Options. First You Can Backflip[Q]
    Which Doesn't Take Much Energy or You Could Dash[SHIFT] Which Takes A Lotta Effort
    So Don't Be Doin That A Lot. Something Else You Can do Is the Slide[C] Which
    Allows You To Slide Under Enemies If You're In A Bad Situation It However does
    take a Moderate Amount Of Energy.
  - When An Enemy Is Glowing Red They Either Shoot a Projectile or Do Sum That Stuns
    You. Most of The Time It's Best You Backflip Or Try Sum To Get Off The Ground.
    If Stunned You Must Use Your Dash To Get Out, If You Don't Have Enough Energy
    You Could Try to Slide Which Won't Take Energy In this State.
  - 'One More Thing, Doin Anything But Punching And Jumping Takes Energy When You
    Are Depleted You''re Kinda Cooked. So Just Punch Enemies To Get That Stuff Back. '
  MainText: {fileID: 1821273712}
  Value: 0
  AudioP: {fileID: 590502044}
  SFX: {fileID: 8300000, guid: 6e61efa72de3c1945870798869b36c85, type: 3}
  R_Arrow: {fileID: 2107035847}
  L_Arrow: {fileID: 1657432319}
  PauseManager: {fileID: 1857402268}
  Self: {fileID: 877011506}
  IntroBattle: 1
  Player: {fileID: 228098106}
  isGunTUT: 0
